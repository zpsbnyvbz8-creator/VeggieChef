{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "critic": {
      "description": "Senior-Code-Reviewer für VeggieChef (TypeScript, React 19, Express, Firebase Sync, KI-Endpoints). Fokus auf Bugs, Konsistenz, Architektur.",
      "mode": "subagent",
      "system": "Review changes for correctness and regressions. List findings in severity order with file and line references.",
      "permissions": [
        { "action": "read", "resource": "**/*", "effect": "allow" },
        { "action": "glob", "resource": "**/*", "effect": "allow" },
        { "action": "grep", "resource": "**/*", "effect": "allow" },
        { "action": "edit", "resource": "**/*.md", "effect": "allow" },
        { "action": "edit", "resource": ".opencode/agents/*.md", "effect": "allow" },
        { "action": "edit", "resource": "src/**", "effect": "deny" },
        { "action": "edit", "resource": "server/**", "effect": "deny" },
        { "action": "edit", "resource": "api/**", "effect": "deny" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "git branch*", "effect": "allow" },
        { "action": "shell", "resource": "npx tsc --noEmit*", "effect": "allow" },
        { "action": "shell", "resource": "tsc --noEmit*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "security-auditor": {
      "description": "Security-Auditor für VeggieChef (Express, Firebase/Firestore, Gemini, CSP/CORS, AI-Upload).",
      "mode": "subagent",
      "permissions": [
        { "action": "read", "resource": "**/*", "effect": "allow" },
        { "action": "glob", "resource": "**/*", "effect": "allow" },
        { "action": "grep", "resource": "**/*", "effect": "allow" },
        { "action": "edit", "resource": "**/*.md", "effect": "allow" },
        { "action": "edit", "resource": ".opencode/agents/*.md", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "src/**", "effect": "deny" },
        { "action": "edit", "resource": "server/**", "effect": "deny" },
        { "action": "edit", "resource": "api/**", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "testing": {
      "description": "Testing-Agent für VeggieChef. Erkennt fehlende Tests, erstellt sinnvolle Playwright/E2E- oder Unit-Tests ohne überflüssiges Boilerplate.",
      "mode": "subagent",
      "permissions": [
        { "action": "read", "resource": "**/*", "effect": "allow" },
        { "action": "glob", "resource": "**/*", "effect": "allow" },
        { "action": "grep", "resource": "**/*", "effect": "allow" },
        { "action": "edit", "resource": "**/*.spec.*", "effect": "allow" },
        { "action": "edit", "resource": "**/*.test.*", "effect": "allow" },
        { "action": "edit", "resource": "playwright.config.*", "effect": "allow" },
        { "action": "edit", "resource": "tests/**/*", "effect": "allow" },
        { "action": "edit", "resource": "e2e/**/*", "effect": "allow" },
        { "action": "edit", "resource": "**/*.md", "effect": "allow" },
        { "action": "edit", "resource": ".opencode/agents/*.md", "effect": "allow" },
        { "action": "shell", "resource": "npx playwright*", "effect": "allow" },
        { "action": "shell", "resource": "npx vitest*", "effect": "allow" },
        { "action": "shell", "resource": "npx tsc --noEmit*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "src/**", "effect": "deny" },
        { "action": "edit", "resource": "server/**", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "ai-prompt": {
      "description": "AI/Prompt-Engineer für VeggieChef – optimiert Gemini-Prompts, Schemas, Fallbacks, JSON-Robustheit & Kosten.",
      "mode": "subagent",
      "permissions": [
        { "action": "read", "resource": "**/*", "effect": "allow" },
        { "action": "glob", "resource": "**/*", "effect": "allow" },
        { "action": "grep", "resource": "**/*", "effect": "allow" },
        { "action": "edit", "resource": "server/routes/ai.ts", "effect": "allow" },
        { "action": "edit", "resource": "server/gemini.ts", "effect": "allow" },
        { "action": "edit", "resource": "server/schemas.ts", "effect": "allow" },
        { "action": "edit", "resource": "server/prompts/**", "effect": "allow" },
        { "action": "edit", "resource": "server/fallbacks.ts", "effect": "allow" },
        { "action": "edit", "resource": "server/normalizer.ts", "effect": "allow" },
        { "action": "edit", "resource": "**/*.md", "effect": "allow" },
        { "action": "edit", "resource": ".opencode/agents/*.md", "effect": "allow" },
        { "action": "shell", "resource": "npx tsc --noEmit*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "src/**", "effect": "deny" },
        { "action": "edit", "resource": "api/**", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "web-agent": {
      "description": "Web-Recherche-Agent für Tech/Docs (React/Vite/Express/Firebase/Playwright). Faktenbasiert, keine Spekulation.",
      "mode": "subagent",
      "permissions": [
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "**/*", "effect": "allow" },
        { "action": "glob", "resource": "**/*", "effect": "allow" },
        { "action": "grep", "resource": "**/*", "effect": "allow" },
        { "action": "edit", "resource": "**/*.md", "effect": "allow" },
        { "action": "edit", "resource": ".opencode/agents/*.md", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "src/**", "effect": "deny" },
        { "action": "edit", "resource": "server/**", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "explore": {
      "description": "Fast agent specialized for exploring codebases. Use this when you need to quickly find files by patterns, search code for keywords, or answer questions about the codebase.",
      "mode": "subagent",
      "permissions": [
        { "action": "read", "resource": "**/*", "effect": "allow" },
        { "action": "glob", "resource": "**/*", "effect": "allow" },
        { "action": "grep", "resource": "**/*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "**/*.md", "effect": "allow" },
        { "action": "edit", "resource": ".opencode/agents/*.md", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "src/**", "effect": "deny" },
        { "action": "edit", "resource": "server/**", "effect": "deny" },
        { "action": "edit", "resource": "api/**", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "general": {
      "description": "General-purpose agent for researching complex questions and executing multi-step tasks. Use this agent to execute multiple units of work in parallel.",
      "mode": "subagent",
      "permissions": [
        { "action": "read", "resource": "**/*", "effect": "allow" },
        { "action": "glob", "resource": "**/*", "effect": "allow" },
        { "action": "grep", "resource": "**/*", "effect": "allow" },
        { "action": "edit", "resource": "**/*.md", "effect": "allow" },
        { "action": "edit", "resource": ".opencode/agents/*.md", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "npx tsc --noEmit*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "src/**", "effect": "deny" },
        { "action": "edit", "resource": "server/**", "effect": "deny" },
        { "action": "edit", "resource": "api/**", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "uiux": {
      "description": "UI/UX-Designer & Reviewer für VeggieChef – objektive Bewertung, kommerziell-professioneller Look ohne AI-Slop/Marketing-Fluff.",
      "mode": "subagent",
      "permissions": [
        { "action": "read", "resource": "**/*", "effect": "allow" },
        { "action": "glob", "resource": "**/*", "effect": "allow" },
        { "action": "grep", "resource": "**/*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "**/*.md", "effect": "allow" },
        { "action": "edit", "resource": ".opencode/agents/*.md", "effect": "allow" },
        { "action": "edit", "resource": "src/styles/**", "effect": "allow" },
        { "action": "edit", "resource": "src/index.css", "effect": "allow" },
        { "action": "edit", "resource": "tailwind.config.*", "effect": "allow" },
        { "action": "edit", "resource": "postcss.config.*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "npx tsc --noEmit*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "src/**", "effect": "deny" },
        { "action": "edit", "resource": "server/**", "effect": "deny" },
        { "action": "edit", "resource": "api/**", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    }
  }
}