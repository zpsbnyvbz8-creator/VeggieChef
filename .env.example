# ==============================================================================
# VeggieChef – Environment Variables Configuration (Vercel & Cloud Hosting)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gemini AI API Key (Server-Side / Vercel Serverless Function)
# ------------------------------------------------------------------------------
# Required for AI-powered features:
# - Kühlschrank-Resteverwerter (Fridge Cook)
# - Zutatentausch-Assistent (Ingredient Substitution)
# - Rezept-Veganisierer (Recipe Veganizer)
# - Wochenplan-Generator (Meal Plan Generator)
# - Rezept-Scanner per Foto (Photo Recipe Scanner)
# On Vercel: Set under Project Settings -> Environment Variables.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 2. Application Base URL
# ------------------------------------------------------------------------------
# Host URL of the deployed application (e.g., https://veggiechef.vercel.app).
# Used for canonical links, absolute asset routing, and self-referential endpoints.
APP_URL="https://your-veggiechef-app.vercel.app"

# ------------------------------------------------------------------------------
# 3. Firebase Client Configuration (Vercel Client-Side Environment Variables)
# ------------------------------------------------------------------------------
# These variables configure Firebase Anonymous Auth and Firestore for:
# - Recipe Collections (Custom recipes & AI generations)
# - Family Sync & Multi-Device Real-time Collaboration
# - Weekly Meal Planner & Shopping List Persistence
#
# If not provided via environment variables, the app automatically falls back
# to the local `firebase-applet-config.json` bundled with the project.
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_DATABASE_ID="ai-studio-veggiechef-d6f18365-d6e0-46c2-8426-06657b15cc1f"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="1057627168096"
VITE_FIREBASE_APP_ID="1:1057627168096:web:4cf563eec12c6858d35205"
